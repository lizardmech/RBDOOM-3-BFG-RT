public static const uint kUpt10ShiftInvalid = 0u;
public static const uint kUpt10ShiftValidZero = 1u;
public static const uint kUpt10ShiftValidPositive = 2u;

public static const uint kUpt10RouteNone = 0u;
public static const uint kUpt10RoutePrimaryNee = 1u;
public static const uint kUpt10RouteReplayOrReconnect = 2u;

// Mechanical shift providers fill this record. routeLabel reports how the
// mapping was built; downstream estimator math must use only mappingStatus,
// source/target measures and shiftJacobian.
public struct Upt10ShiftResult
{
    uint mappingStatus;
    uint routeLabel;
    uint mappingVisibilityConsumed;
    uint deferredVisibilityRequired;
    Upt03Candidate shifted;
    float sourceTarget;
    float targetTarget;
    float shiftJacobian;
    uint reserved0;
};

// routeLabel is diagnostic metadata. The common estimator must never read it.
public struct Upt10MappedProposalInput
{
    uint status;
    uint routeLabel;
    uint sourceConfidence;
    uint reserved0;

    float sourceScaledWeight;
    float sourceTarget;
    float targetTarget;
    float shiftJacobian;

    float pairwiseMis;
    float reserved1;
    float reserved2;
    float reserved3;
};

public struct Upt10MergeControl
{
    float winnerRandom;
    uint reserved0;
    uint reserved1;
    uint reserved2;
};

public struct Upt10MergeResult
{
    float totalMappedMass;
    uint selectedOrdinal;
    uint outputConfidence;
    uint validMask;
};

struct Upt10MappedProposal
{
    float mass;
    uint confidence;
    uint valid;
};

bool Upt10FiniteNonNegative(float value)
{
    return isfinite(value) && value >= 0.0f;
}

bool Upt10FinitePositive(float value)
{
    return isfinite(value) && value > 0.0f;
}

Upt10MappedProposal Upt10MapProposal(Upt10MappedProposalInput input)
{
    Upt10MappedProposal result = (Upt10MappedProposal)0;
    if (input.status != kUpt10ShiftValidZero &&
        input.status != kUpt10ShiftValidPositive)
        return result;

    if (!Upt10FiniteNonNegative(input.sourceScaledWeight) ||
        !Upt10FiniteNonNegative(input.sourceTarget) ||
        !Upt10FiniteNonNegative(input.targetTarget) ||
        !Upt10FinitePositive(input.shiftJacobian) ||
        !Upt10FiniteNonNegative(input.pairwiseMis))
        return result;

    if (input.status == kUpt10ShiftValidZero)
    {
        if (input.targetTarget != 0.0f)
            return result;
        result.confidence = input.sourceConfidence;
        result.valid = 1u;
        return result;
    }
    if (!Upt10FinitePositive(input.sourceTarget) ||
        !Upt10FinitePositive(input.targetTarget))
        return result;

    const float sourceUcw = input.sourceScaledWeight / input.sourceTarget;
    const float mappedMass = input.pairwiseMis * input.targetTarget *
        sourceUcw * input.shiftJacobian;
    if (!Upt10FiniteNonNegative(sourceUcw) ||
        !Upt10FiniteNonNegative(mappedMass))
        return result;

    result.mass = mappedMass;
    result.confidence = input.sourceConfidence;
    result.valid = 1u;
    return result;
}

uint Upt10SaturatingAdd(uint a, uint b)
{
    return a > 0xffffffffu - b ? 0xffffffffu : a + b;
}

public Upt10MergeResult Upt10MergeMappedPair(
    Upt10MappedProposalInput proposal0,
    Upt10MappedProposalInput proposal1,
    Upt10MergeControl control)
{
    const Upt10MappedProposal mapped0 = Upt10MapProposal(proposal0);
    const Upt10MappedProposal mapped1 = Upt10MapProposal(proposal1);

    Upt10MergeResult result = (Upt10MergeResult)0;
    result.totalMappedMass = mapped0.mass + mapped1.mass;
    result.selectedOrdinal = 0xffffffffu;
    result.outputConfidence = Upt10SaturatingAdd(
        mapped0.confidence, mapped1.confidence);
    result.validMask = mapped0.valid | (mapped1.valid << 1u);

    if (!Upt10FinitePositive(result.totalMappedMass))
        return result;

    const float random01 = clamp(control.winnerRandom, 0.0f, 0.99999994f);
    result.selectedOrdinal = random01 * result.totalMappedMass < mapped0.mass
        ? 0u : 1u;
    return result;
}
