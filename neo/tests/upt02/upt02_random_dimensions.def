// Language-neutral source table for UPT random ownership.
//
// Consumers define UPT_RANDOM_SLOT(name, pass, stream, dimension) before
// including this file.  sampleOrdinal distinguishes repeated draws in one
// slot; pathVertex distinguishes continuation depth.  Neither changes the
// numeric identifiers below.

UPT_RANDOM_SLOT(InitialFamilySelection,       0x0001u, 0x0001u, 0u)
UPT_RANDOM_SLOT(InitialReservoirSelection,    0x0001u, 0x0002u, 0u)
UPT_RANDOM_SLOT(MaterialLobeSelection,        0x0001u, 0x0003u, 0u)
UPT_RANDOM_SLOT(MaterialDirectionU,           0x0001u, 0x0003u, 1u)
UPT_RANDOM_SLOT(MaterialDirectionV,           0x0001u, 0x0003u, 2u)
UPT_RANDOM_SLOT(AnalyticLightSelection,        0x0001u, 0x0004u, 0u)
UPT_RANDOM_SLOT(AnalyticLightSurfaceU,         0x0001u, 0x0004u, 1u)
UPT_RANDOM_SLOT(AnalyticLightSurfaceV,         0x0001u, 0x0004u, 2u)
UPT_RANDOM_SLOT(EmissiveLightSelection,        0x0001u, 0x0005u, 0u)
UPT_RANDOM_SLOT(EmissiveSurfaceU,              0x0001u, 0x0005u, 1u)
UPT_RANDOM_SLOT(EmissiveSurfaceV,              0x0001u, 0x0005u, 2u)
UPT_RANDOM_SLOT(EnvironmentDirectionU,         0x0001u, 0x0006u, 0u)
UPT_RANDOM_SLOT(EnvironmentDirectionV,         0x0001u, 0x0006u, 1u)
UPT_RANDOM_SLOT(IndirectContinuationU,         0x0001u, 0x0007u, 0u)
UPT_RANDOM_SLOT(IndirectContinuationV,         0x0001u, 0x0007u, 1u)
UPT_RANDOM_SLOT(IndirectRouletteSurvival,      0x0001u, 0x0007u, 2u)
UPT_RANDOM_SLOT(ReplayPathEvent,                0x0002u, 0x0008u, 0u)
UPT_RANDOM_SLOT(TemporalTapSelection,           0x0003u, 0x0009u, 0u)
UPT_RANDOM_SLOT(TemporalReservoirSelection,     0x0003u, 0x0002u, 0u)
UPT_RANDOM_SLOT(SpatialNeighborCoordinateU,     0x0004u, 0x000au, 0u)
UPT_RANDOM_SLOT(SpatialNeighborCoordinateV,     0x0004u, 0x000au, 1u)
UPT_RANDOM_SLOT(SpatialReservoirSelection,      0x0004u, 0x0002u, 0u)
